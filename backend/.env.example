APP_NAME="Permis Maroc"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL via Docker Compose (recommended local setup):
#   docker compose up -d
# Host artisan/tests talking to published MySQL port:
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=permis_maroc
DB_USERNAME=permis
DB_PASSWORD=secret
# DB_SOCKET=

# Inside the api container, compose overrides DB_HOST=mysql

# Local fallback without Docker/MySQL:
# DB_CONNECTION=sqlite
# # leave DB_DATABASE empty and use database/database.sqlite via Laravel default


SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.permis-maroc.com
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Local development (cookies on localhost):
# SESSION_DOMAIN=null
# SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@permis-maroc.com"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:3000,permis-maroc.com,www.permis-maroc.com,api.permis-maroc.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://permis-maroc.com,https://www.permis-maroc.com

SMS_DRIVER=log
OTP_EXPIRES_MINUTES=10
OTP_MAX_ATTEMPTS=5

VITE_APP_NAME="${APP_NAME}"
